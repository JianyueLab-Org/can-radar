---
/**
 * 404。外壳照常（地图站的 `map` 布局），正文是 can-ui 的 `NotFound`：全网同一份
 * 404 版式和文案。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/Frame.vue";
import { NotFound, notFoundText, originsFromEnv } from "@jianyuelab-org/can-ui";
import { getLocale, getMessages } from "@/lib/i18n";
import { signInUrl } from "@/server/config";
import { readMember } from "@/server/session";

const locale = getLocale(Astro.cookies);
const member = await readMember(Astro);
if (member) Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout title={notFoundText(locale).title} floatingControls={false}>
  <Frame
    messages={getMessages(locale, "header")}
    locale={locale}
    pathname={Astro.url.pathname}
    member={member}
    signInHref={signInUrl(Astro.url)}
    client:load
  >
    <div class="flex min-h-full flex-col">
      <NotFound
        current="radar"
        locale={locale}
        homeHref="/"
        origins={originsFromEnv(import.meta.env)}
      />
    </div>
  </Frame>
</BaseLayout>
