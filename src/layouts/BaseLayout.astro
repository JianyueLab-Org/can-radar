---
/**
 * Leaflet 自己的样式，**必须排在 globals.css 前面**，好让站点段盖过它。
 *
 * 它原来是从 RadarMap.vue 里引的，那样它会作为岛屿的动态样式表插在 <head> 末
 * 尾，反过来盖住站点段里针对版权条和比例尺的那几条同权重规则。放在这里，覆盖顺
 * 序就是文件顺序。字体不另外引：用 can-ui 的 `--font-sans` / `--font-mono`。
 */
import "leaflet/dist/leaflet.css";

import "@/styles/globals.css";
import ThemeScript from "@jianyuelab-org/can-ui/components/ThemeScript.astro";
import { ThemeLangControls } from "@jianyuelab-org/can-ui";
import { getLocale } from "@/lib/i18n";
import { pageTitle } from "@/lib/pageTitle";

interface Props {
  /** 页面部分；完整标题由 `pageTitle()` 拼。首页不传。 */
  title?: string;
  description?: string;
  /**
   * Pages inside `Frame` (CanFrame carries ThemeLangControls) set this to
   * false. Only the chrome-less pages fall back to the floating pill.
   */
  floatingControls?: boolean;
}

const {
  title,
  description = "A Friendly, Open, and Enthusiastic Flight Simulation Platform — Dedicated to Your Enjoyment",
  floatingControls = true,
} = Astro.props;

const locale = getLocale(Astro.cookies);
const fullTitle = pageTitle(title, locale);
---

<!doctype html>
<html lang={locale} class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b0f14"
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo-full.png" />
    <ThemeScript />
  </head>
  <body>
    <slot />
    {
      floatingControls && (
        <ThemeLangControls locale={locale} variant="floating" client:idle />
      )
    }
  </body>
</html>
